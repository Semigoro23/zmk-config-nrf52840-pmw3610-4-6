#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            display-name = "Base";
            bindings = <
                &kp ESC    &kp N1 &kp N2 &kp N3 &kp N4 &kp N5      &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BACKSPACE
                &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T       &kp Y  &kp U  &kp I  &kp O  &kp P  &kp RBKT
                &kp LSHIFT &kp A  &kp S  &kp D  &kp F  &kp G       &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp COLON
                &kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B       &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp MINUS

                           &kp LALT &kp SPACE &mo 1 &mo 2 &kp ENTER  &mkp MB1 &mkp MB2 &mo 3
            >;
        };

        layer_1 {
            display-name = "Edit";
            bindings = <
                &kp EXCL  &kp AT &kp HASH &kp DLLR &kp PRCNT &kp CARET       &kp AMPS &kp ASTERISK &kp LPAR &kp RPAR &kp MINUS &kp INT_YEN
                &kp TAB   &none &kp LC(W) &kp LG(E) &kp LG(R) &kp LC(T)      &kp LC(Y) &kp END &kp END &kp LBKT &kp RBKT &kp INT_YEN
                &kp CAPS  &none &kp PSCRN &kp LG(D) &kp LC(C) &kp LC(X)     &kp DEL &kp LC(V) &kp DEL &kp LG(L) &none &kp LS(BSLH)
                &kp LCTRL &kp LC(Z) &none &kp LC(Z) &kp LC(A) &kp BACKSPACE &kp LC(N) &kp LC(V) &kp COMMA &kp DOT &kp FSLH &kp UNDERSCORE

                          &kp LALT &kp SPACE &trans &mo 2 &kp ENTER           &mkp MB1 &mkp MB2 &mo 3
            >;
        };

        layer_2 {
            display-name = "Symbols";
            bindings = <
                &kp ESC    &kp F1 &kp F2 &kp F3 &kp F4 &kp F5               &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &none
                &kp TAB    &kp EXCL &kp DQT &kp HASH &kp DLLR &kp PRCNT     &kp AMPS &kp SQT &kp LPAR &kp RPAR &kp DEL &kp LS(BSLH)
                &kp LSHIFT &none &none &kp LBKT &kp SEMI &kp LPAR            &kp RPAR &kp COLON &kp RBKT &kp AT &none &kp BACKSLASH
                &kp LCTRL  &kp LGUI &none &none &none &kp DOT                &kp DOT &kp FSLH &kp COMMA &kp DOT &none &kp UNDERSCORE

                           &kp LALT &kp SPACE &mo 1 &trans &kp ENTER          &mkp MB1 &mkp MB2 &mo 3
            >;
        };

        layer_3 {
            display-name = "Mouse";
            bindings = <
                &kp ESC    &kp F13 &kp F14 &kp F15 &kp F16 &kp F17          &kp F18 &kp F19 &kp F20 &kp F21 &kp F22 &none
                &kp TAB    &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &none &none &kp UP &none &none &kp C_VOL_UP
                &kp LSHIFT &none &none &none &none &kp LC(LS(TAB))          &kp LC(TAB) &kp LEFT &kp DOWN &kp RIGHT &none &kp C_VOL_DN
                &kp LCTRL  &kp LGUI &none &none &none &kp HOME              &kp END &none &none &none &none &kp RCTRL

                           &kp LALT &kp SPACE &mo 1 &mo 2 &kp ENTER           &mkp MB1 &mkp MB2 &trans
            >;
        };
    };
};
